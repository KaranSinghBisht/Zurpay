# Payroll Builder Service Environment Variables

# Server port (default: 3001)
PORT=3001

# ====================
# Solana RPC Configuration
# ====================

# Helius API Key (RECOMMENDED for enhanced privacy and reliability)
# Get your free API key from https://dev.helius.xyz
# When set, automatically uses Helius devnet RPC
HELIUS_API_KEY=

# Fallback RPC URL (used when HELIUS_API_KEY is not set)
# Default: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# REQUIRED: Internal secret for service-to-service authentication
# Must be set to a secure random value (min 32 characters recommended)
# Generate with: openssl rand -hex 32
PAYROLL_BUILDER_INTERNAL_SECRET=

# REQUIRED: JWT secret for authentication tokens
# Must be set to a secure random value (min 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED: Encryption key for payroll amounts
# MUST be different from JWT_SECRET (security requirement)
# Generate with: openssl rand -hex 32
PAYROLL_ENCRYPTION_KEY=

# Legacy endpoints feature flag (default: false)
# WARNING: Legacy endpoints have security vulnerabilities and should NOT be enabled in production
# Only enable for backwards compatibility during migration
ENABLE_LEGACY_ENDPOINTS=false

# Database URL for Prisma
# For SQLite (development): DATABASE_URL="file:./zurpay.db"
# For PostgreSQL (production): DATABASE_URL="postgresql://user:password@host:5432/zurpay?schema=public"
# PostgreSQL with connection pooling (recommended for production):
# DATABASE_URL="postgresql://user:password@host:5432/zurpay?schema=public&connection_limit=20"
DATABASE_URL="file:./zurpay.db"

# Mock prover for development (default: false)
# Set to true to skip real ZK proof generation
USE_MOCK_PROVER=false

# Path to Sunspot binary for real proof generation
# Required when USE_MOCK_PROVER=false
# SUNSPOT_BIN=/path/to/sunspot

# Redis URL for rate limiting (recommended for production)
# Without Redis, rate limiting uses in-memory store (not suitable for horizontal scaling)
# Example: redis://localhost:6379 or redis://:password@host:6379
REDIS_URL=

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000,http://localhost:3002 (local dev only)
# Production example: https://admin.zurpay.io,https://app.zurpay.io
ALLOWED_ORIGINS=

# Email configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Zurpay <noreply@zurpay.io>
EMPLOYEE_APP_URL=http://localhost:3002
