# Zurpay Employee App Environment Variables

# ====================
# Solana RPC Configuration
# ====================

# Helius API Key (RECOMMENDED for enhanced privacy and reliability)
# Get your free API key from https://dev.helius.xyz
# When set, automatically uses Helius devnet RPC
NEXT_PUBLIC_HELIUS_API_KEY=

# Fallback RPC URL (used when NEXT_PUBLIC_HELIUS_API_KEY is not set)
# Default: https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ====================
# Service URLs
# ====================

# Payroll Builder Service URL (backend API)
# Local: http://localhost:3001
# Production: https://pleasing-cooperation-production-1f28.up.railway.app
NEXT_PUBLIC_PAYROLL_BUILDER_URL=http://localhost:3001

# ====================
# Cross-App Navigation URLs
# ====================

# Admin App URL (for navigation)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# Employee App URL (this app)
NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:3002

# Docs URL (for navigation)
NEXT_PUBLIC_DOCS_URL=http://localhost:3003

# ====================
# Program IDs (Devnet)
# ====================

# Zurpay Program ID
NEXT_PUBLIC_ZURPAY_PROGRAM_ID=Cf9tReQuvS6cb4awYPCVozQnCWYdqia62yRShJs2URy9

# ZK Verifier Program ID (Sunspot V4)
NEXT_PUBLIC_ZK_VERIFIER_PROGRAM_ID=4MZoLmEsXE1hx62GeSRABGzSGEv7isjck8h4rsnidFkU

# Inco Lightning Program ID
NEXT_PUBLIC_INCO_PROGRAM_ID=5sjEbPiqgZrYwR31ahR6Uk9wf5awoX61YGg7jExQSwaj

# ====================
# Deployment Notes
# ====================

# FRONTEND (Vercel):
# 1. Import repo to Vercel, set Root Directory: apps/employee
# 2. Add all NEXT_PUBLIC_* env vars
#
# BACKEND (Railway):
# Set NEXT_PUBLIC_PAYROLL_BUILDER_URL to your Railway URL
# Example: https://zurpay-api-production.up.railway.app
#
# Cross-App URLs for Production:
# NEXT_PUBLIC_ADMIN_URL=https://zurpay-admin.vercel.app
# NEXT_PUBLIC_EMPLOYEE_APP_URL=https://zurpay-employee.vercel.app
# NEXT_PUBLIC_DOCS_URL=https://zurpay-docs.vercel.app
